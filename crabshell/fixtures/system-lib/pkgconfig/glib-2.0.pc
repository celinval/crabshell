# Stands in for GLib installed in a prefix of the consumer's choosing, which
# `.cargo/config.toml` points glib-sys at through PKG_CONFIG_PATH. Nothing
# links, so only the build script's view of the library matters.
prefix=${pcfiledir}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: GLib
Description: C Utility Library
Version: 2.86.0
Libs: -L${libdir} -lglib-2.0
Cflags: -I${includedir}/glib-2.0
